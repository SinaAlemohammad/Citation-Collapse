# Copy this file to .env and paste your real keys. .env is gitignored.
# You only need the key(s) for the vendor(s) you actually call.
# Re-extraction, figures and analysis read local files only -- no keys needed.

OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
# Gemini: the SDK reads GOOGLE_API_KEY first, then GEMINI_API_KEY. Set ONE.
GEMINI_API_KEY=...
